# SWAGGYMUSIC — Example environment variables
#
# Copy this file to `.env` (local) or set the same variables as Heroku
# Config Vars. Never commit a real `.env` file containing actual secrets.
#
# All values below are intentionally EMPTY — fill them in with your own
# credentials obtained from the appropriate providers.

# Required — from https://my.telegram.org/apps
API_ID=
API_HASH=

# Required — from @BotFather on Telegram
BOT_TOKEN=

# Required — Telegram log group ID (add the bot to your log group and
# promote it as an administrator)
LOGGER_ID=

# Required — Telegram user ID of the bot owner (get it from @userinfobot)
OWNER_ID=

# Required — MongoDB connection URI from https://cloud.mongodb.com
MONGO_URL=

# Required — Pyrogram v2 string session for the assistant/userbot
# (generate one from @StringFatherBot on Telegram)
SESSION=

# Optional — additional assistant userbot sessions
SESSION2=
SESSION3=

# Optional — ShrutiBots API key (required if you want to use the
# ShrutiBots fallback downloader). Get it from @SHRUTIAPIBOT on Telegram.
# This MUST be provided via environment; there is no hardcoded fallback.
SHRUTI_API_KEY=
SHRUTI_API_URL=

# Optional public/non-secret settings (sensible defaults are baked into
# config.py — override here only if you need to customize)
SUPPORT_CHANNEL=
SUPPORT_CHAT=
DURATION_LIMIT=
QUEUE_LIMIT=
PLAYLIST_LIMIT=
AUTO_LEAVE=
AUTO_END=
THUMB_GEN=
VIDEO_PLAY=
LANG_CODE=
COOKIES_URL=
DEFAULT_THUMB=
PING_IMG=
START_VIDEO=
